# FUNCTION 8: Generate Class Performance Report
def generate_report():
    print('\n---CLASS PERFORMANCE REPORT---')

    if len(students) == 0:
        print('No students registered yet.')
        return

    total_students = len(students)
    passed = 0
    failed = 0
    total_sum = 0
    highest = students[0]['total']
    lowest = students[0]['total']

   # Loop to count pass/fail, sum, highest, lowest
    for student in students:
        total_sum = total_sum + student['total']

        if student['status'] == 'Pass':
            passed = passed + 1
        else: 
            failed = failed + 1

        if student['total'] > highest:
            highest = student['total']

        if student['total'] < lowest:
            lowest = student['total']

    average = total_sum / total_students

    print(f'Total Number of Students Registered: {total_students}')
    print(f'Number of Students Who Passed: {passed}')
    print(f'Number of Students Who Failed: {failed}')
    print(f'Class Average: {average:.2f}')
    print(f'Highest Score: {highest:.2f}')
    print(f'Lowest Score: {lowest:.2f}')

