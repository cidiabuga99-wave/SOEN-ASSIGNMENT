# FUNCTION 1: Get a valid mark from user
# Marks must be between 0 and 100

def get_valid_mark(prompt):
    while True:
        try:
            mark = float(input(prompt))
            if mark < 0 or  mark > 100:
                print('Invalid! Mark must be between 0 and 100. Try again.')
            else: 
                return mark
        except ValueError:
            print('Invalid! Please enter a number, not text.')

# FUNCTION 2: Calculate total marks using weighting
# CAT 1 = 15%, CAT 2 = 15%, Exam = 70%

def calculate_total(cat1, cat2, exam ):
    total = (cat1 * 0.15) + (cat2 * 0.15) + (exam * 0.70)
    return total

# FUNCTION 3: Assign grad eusing if, elif,else statements

def get_grade(total):
    if total >= 70:
        return 'A'
    elif total >= 60:
        return 'B'
    elif total >= 50:
        return 'C'
    elif total >= 40:
        return 'D'
    else:
        return 'E'

# FUNCTION 4 : Determine pass or fail
# Pass mark is 40 and above

def get_status(total):
    if total >= 40:
        return 'Pass'
    else: 
        return 'Fail'
        
# FUNCTION 5: Register a student

def register_student(): 
    print('\n--- REGISTER STUDENT ---')

    reg_no = input('Enter Registration Number: ')
    name = input('Enter Full Name: ')

    # Get marks with validation
    cat1 = get_valid_mark('Enter CAT 1 Mark: ')
    cat2 = get_valid_mark('Enter CAT 2 Mark: ')
    exam = get_valid_mark('Enter End of Semester Exam Mark: ')

    # Calculate total, grade and status using functions
    total = calculate_total(cat1, cat2, exam)
    grade = get_grade(total)
    status = get_status(total)

    # Create a student record as a dictionary
    student = {
        'reg_no': reg_no,
        'name': name,
        'cat1': cat1,
        'cat2': cat2,
        'exam': exam,
        'total': total,
        'grade': grade,
        'status': status
    }

    # Add student to the list
    students.append(student)

    print('\nStudent registered successfully!')
    print(f'Registration Number: {reg_no}, Name: {name}, Total Marks: {total:.2f}, Grade: {grade}, Status: {status}')

